-- Module: Ferrule.Physics.EDFA
-- Erbium-Doped Fiber Amplifier (EDFA) model and Amplified Spontaneous Emission (ASE) noise.

module Ferrule.Physics.EDFA where

import Ferrule.Types
import Ferrule.Physics.Units

-- Standard factory for a booster or in-line EDFA
standardEdfa :: Float -> Float -> Amplifier
standardEdfa gainDb noiseFigureDb = Amplifier
  { ampGainDb        = gainDb
  , ampNoiseFigureDb  = noiseFigureDb
  , ampMaxPowerDbm   = 23.0  -- Typical +23 dBm saturation output power
  }

-- Spontaneous emission factor: n_sp = 0.5 * 10^(NF_dB / 10) * (G / (G - 1))
spontaneousEmissionFactor :: Float -> Float -> Float
spontaneousEmissionFactor gainDb noiseFigureDb =
  let nfLin = dbToLinear noiseFigureDb
      gLin  = dbToLinear gainDb
  in if gLin <= 1.0
     then 1.0
     else 0.5 * nfLin * (gLin / (gLin - 1.0))

-- Compute ASE noise power spectral density in single polarization: S_ase = h * nu * n_sp * (G - 1)
-- Units: Watts / Hz
asePowerSpectralDensityWpHz :: Float -> Float -> Float -> Float
asePowerSpectralDensityWpHz freqThz gainDb noiseFigureDb =
  let nu    = freqThz * 1.0e12
      gLin  = dbToLinear gainDb
      nsp   = spontaneousEmissionFactor gainDb noiseFigureDb
      hNu   = planckConstantJs * nu
  in hNu * nsp * (gLin - 1.0)

-- Compute total ASE noise power generated by an EDFA across an optical reference bandwidth
-- (e.g. 0.1 nm = 12.5 GHz reference bandwidth, 2 polarizations)
totalAseNoiseWatts :: Float -> Float -> Float -> Float -> Float
totalAseNoiseWatts freqThz gainDb noiseFigureDb referenceBwGhz =
  let psdOnePol = asePowerSpectralDensityWpHz freqThz gainDb noiseFigureDb
      bwHz      = referenceBwGhz * 1.0e9
      twoPolPsd = 2.0 * psdOnePol
  in twoPolPsd * bwHz

-- Compute OSNR contribution of a single amplified span (in dB, reference 0.1 nm bandwidth)
singleSpanOsnrDb :: Float -> Float -> Float -> Float -> Float
singleSpanOsnrDb signalPowerDbm freqThz gainDb noiseFigureDb =
  let sigWatts = dbmToWatts signalPowerDbm
      noiseWatts = totalAseNoiseWatts freqThz gainDb noiseFigureDb 12.5
  in linearToDb (sigWatts / noiseWatts)

-- Cascade OSNR across a chain of N identical spans
cascadedOsnrDb :: Float -> Int -> Float
cascadedOsnrDb singleSpanOsnr numSpans =
  if numSpans <= 1
  then singleSpanOsnr
  else singleSpanOsnr - (10.0 * (log (fromIntegral numSpans) / log 10.0))
